# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.

# Auth0 — generate a random secret: openssl rand -hex 32
AUTH0_SECRET=op://Development/local-auth0/front-end-auth0-secret

# Auth0 domain without https://
AUTH0_DOMAIN=op://Development/local-auth0/front-end-domain

AUTH0_CLIENT_ID=op://Development/local-auth0/front-end-client-id
AUTH0_CLIENT_SECRET=op://Development/local-auth0/front-end-client-secret

# The audience configured in your Auth0 API
AUTH0_AUDIENCE=op://Development/local-auth0/audience

AUTH0_SCOPE=openid profile email read:scorecard write:scorecard read:course write:course read:handicap

# Public URL of this app
APP_BASE_URL=http://localhost:3000

# Spring Boot API (server-side only, never sent to browser)
API_BASE_URL=http://localhost:8080
